{
  "info": {
    "name": "IDR Backend (Member 3) v2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "AI-Enhanced Digital Repository API with login, roles and review workflow.\n\n1. Run `php artisan serve` and the queue worker.\n2. Run the two Login requests in '0. Accounts' first: they store adminToken and studentToken.\n3. Run the folders in order. 'Upload' stores the new artifactId for later requests; '5. Admin deletes' removes it again, so the collection can be re-run with the same PDF. Run `php artisan db:seed` to reset the sample documents.\n\nSeeded accounts: admin@aun.edu.ng / student@aun.edu.ng, password Password123."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "adminId",
      "value": "66f000000000000000000001"
    },
    {
      "key": "studentId",
      "value": "66f000000000000000000002"
    },
    {
      "key": "approvedId",
      "value": "66f0000000000000000000a1",
      "description": "seeded approved sample"
    },
    {
      "key": "seededPendingId",
      "value": "66f0000000000000000000a4",
      "description": "seeded pending sample (uploaded by the student)"
    },
    {
      "key": "artifactId",
      "value": ""
    },
    {
      "key": "sessionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Accounts",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Stores adminToken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@aun.edu.ng\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('Is admin', () => pm.expect(d.user.role).to.eql('admin'));",
                  "pm.collectionVariables.set('adminToken', d.token);",
                  "pm.collectionVariables.set('adminId', d.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Stores studentToken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@aun.edu.ng\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('studentToken', d.token);",
                  "pm.collectionVariables.set('studentId', d.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register: non-AUN email is refused (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Only @aun.edu.ng addresses may register.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kola Ade\",\n  \"email\": \"kola@gmail.com\",\n  \"password\": \"Secret123\",\n  \"password_confirmation\": \"Secret123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 422', () => pm.response.to.have.status(422));",
                  "pm.test('Explains the domain rule', () => pm.expect(pm.response.json().errors.email[0]).to.include('@aun.edu.ng'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register: new AUN student (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Change the email each time you run it (emails are unique). Any 'role' sent is ignored.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kola Ade\",\n  \"email\": \"kola.ade{{$randomInt}}@aun.edu.ng\",\n  \"password\": \"Secret123\",\n  \"password_confirmation\": \"Secret123\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Always a student', () => pm.expect(pm.response.json().data.user.role).to.eql('student'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login: wrong password (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
