APP_NAME=idr-backend
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── MongoDB (primary datastore) ─────────────────────────────
DB_CONNECTION=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=idr
# Atlas example: MONGODB_URI="mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=660

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis = pure PHP (no extension needed, best on Windows); phpredis = faster, needs ext-redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── IDR: accounts ───────────────────────────────────────────
# Only addresses at exactly this domain can register.
IDR_ALLOWED_EMAIL_DOMAIN=aun.edu.ng
# Login token lifetime in minutes (10080 = 7 days).
IDR_TOKEN_TTL_MINUTES=10080
IDR_LOGIN_ATTEMPTS_PER_MINUTE=5
SANCTUM_TOKEN_PREFIX=idr_

# ── IDR: review workflow ────────────────────────────────────
# Student uploads start "pending"; admin uploads skip review unless false.
IDR_AUTO_APPROVE_ADMIN_UPLOADS=true
# Publish students' declared submissions as soon as AI processing succeeds.
IDR_AUTO_APPROVE_SUBMISSIONS=true
# Days to hand in the printed certificate + hard copy before it shows as overdue.
IDR_HARD_COPY_DAYS=14
# Gemini checks a submission looks like a senior project before auto-publishing it.
IDR_AI_SCREENING=true
# Hold a submission for an admin when 30%+ of it closely matches one earlier project.
IDR_SIMILARITY_CHECK=true
IDR_SIMILARITY_FLAG_OVERLAP=0.3
# Date filters in the admin dashboard use this timezone.
IDR_TIMEZONE=Africa/Lagos

# ── IDR ─────────────────────────────────────────────────────
# Next.js frontend origin(s) allowed by CORS (comma-separated)
FRONTEND_URL=http://localhost:3000
# fake = built-in stand-ins (no AI calls), live = real Gemini + Qdrant (app/Services/Ai)
IDR_AI_DRIVER=live
# local | s3 (s3 needs: composer require league/flysystem-aws-s3-v3 "^3.0")
IDR_STORAGE_DISK=local
IDR_UPLOAD_MAX_KB=20480
IDR_INGESTION_QUEUE=ingestion
IDR_CHAT_HISTORY_WINDOW=20
# Hide search results whose raw similarity is below this (unrelated text scores up to ~0.57)
IDR_SEARCH_MIN_SCORE=0.58

# ── AI pipeline (Gemini + Qdrant) ───────────────────────────
GEMINI_API_KEY=
# Must match the Qdrant collection's vector size (gemini-embedding-001 = 3072).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=3072
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Used when the chat model is busy ("high demand" 503). Comma-separated.
GEMINI_CHAT_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# Qdrant Cloud: https://<cluster-id>.<region>.cloud.qdrant.io  (no port = 443, which works on
# networks that block port 6333; adding :6333 also works where that port is open)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=idr_chunks
